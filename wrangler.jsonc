{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xx-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      },
      {
        "name": "CHAT",
        "class_name": "Chat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "Lobby"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Chat"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMMUNITY_BUCKET",
      "bucket_name": "community-bucket"
    },
    {
      "binding": "POSTS_BUCKET",
      "bucket_name": "posts-bucket"
    }
  ],
  "triggers": {
    "crons": ["0 */3 * * *"]
  }
}