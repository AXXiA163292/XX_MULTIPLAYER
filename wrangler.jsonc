{
  "name": "xx-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  // SQLite-backed Durable Objects are available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "vars": {
    // Sonolus handle (the number after #) allowed to create rooms.
    "HOST_HANDLE": "163292"
  }
  // Secret (not committed): npx wrangler secret put SESSION_SECRET
}
