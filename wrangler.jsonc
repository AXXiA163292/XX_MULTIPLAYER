
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xx-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  },
  "vars": {
    "RESEND_FROM_EMAIL": "XX! <onboarding@resend.dev>"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      },
      {
        "name": "CHAT",
        "class_name": "Chat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "Lobby"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Chat"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Replays"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["Replays"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMMUNITY_BUCKET",
      "bucket_name": "community"
    },
    {
      "binding": "SONOLUS_ASSETS_BUCKET",
      "bucket_name": "sonolus-assets"
    }
  ],
  "triggers": {
    "crons": ["0 */3 * * *"]
  }
}