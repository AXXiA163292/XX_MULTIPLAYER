{
  "name": "xx-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "POSTS_BUCKET",
      "bucket_name": "sonolus-assets"
    },
    {
      "binding": "COMMUNITY_BUCKET",
      "bucket_name": "community"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room",
        "Lobby"
      ]
    }
  ],
  "vars": {
    "HOST_HANDLE": "163292"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}